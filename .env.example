# =========================================================
# Finalcase local infrastructure environment
# Copy to .env and edit secrets before running compose.
# =========================================================

COMPOSE_PROJECT_NAME=finalcase

# Host ports
API_GATEWAY_PORT=18080
EUREKA_PORT=18761
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
PROMETHEUS_PORT=19090
GRAFANA_PORT=13001
LOKI_PORT=13100
JAEGER_UI_PORT=16686

# PostgreSQL local
POSTGRES_USER=finalcase
POSTGRES_PASSWORD=finalcase
POSTGRES_DB=postgres

# RabbitMQ local
RABBITMQ_DEFAULT_USER=finalcase
RABBITMQ_DEFAULT_PASS=finalcase

# JWT
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_BASE64_32_BYTE_SECRET
JWT_ISSUER=finalcase-auth-service
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000

# Refresh token hashing
# Generate with: openssl rand -base64 32
REFRESH_TOKEN_PEPPER=CHANGE_ME_REFRESH_TOKEN_PEPPER
REFRESH_TOKEN_EXPIRATION_SECONDS=604800
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=Strict

# Iyzico placeholder values for local/dev
IYZICO_API_KEY=local-iyzico-api-key
IYZICO_SECRET_KEY=local-iyzico-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
PAYMENT_PUBLIC_BASE_URL=http://localhost:18080

# Observability
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces

# AWS/ECR/EB deploy placeholders used by GitHub Actions
AWS_REGION=eu-central-1
ECR_REPOSITORY_PREFIX=finalcase
EB_APPLICATION_NAME=finalcase-backend
EB_ENVIRONMENT_NAME=finalcase-backend-env
EB_DEPLOY_BUCKET=finalcase-eb-deployments
SLACK_WEBHOOK_URL=
