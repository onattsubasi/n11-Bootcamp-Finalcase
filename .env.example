# Finalcase local/deployment template
# Copy to .env for local Docker Compose usage.
# Never commit real secrets.

# ------------------------------------------------------------
# Image registry
# ------------------------------------------------------------
BACKEND_IMAGE_REGISTRY=ghcr.io
BACKEND_IMAGE_OWNER=onattsubasi
BACKEND_IMAGE_PREFIX=finalcase
IMAGE_TAG=latest

# ------------------------------------------------------------
# Spring / public URLs
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
FRONTEND_PUBLIC_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------
# Local PostgreSQL
# ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finalcasedb
POSTGRES_USER=finalcase_app
POSTGRES_PASSWORD=change-me

# Per-service DB URLs - local compose
AUTH_DB_URL=jdbc:postgresql://postgres:5432/finalcasedb?currentSchema=auth
USER_DB_URL=jdbc:postgresql://postgres:5432/finalcasedb?currentSchema=users
CATALOG_DB_URL=jdbc:postgresql://postgres:5432/finalcasedb?currentSchema=catalog
SEARCH_DB_URL=jdbc:postgresql://postgres:5432/finalcasedb?currentSchema=search
BASKET_DB_URL=jdbc:postgresql://postgres:5432/finalcasedb?currentSchema=basket
INVENTORY_DB_URL=jdbc:postgresql://postgres:5432/finalcasedb?currentSchema=inventory
PROMOTION_DB_URL=jdbc:postgresql://postgres:5432/finalcasedb?currentSchema=promotion
ORDER_DB_URL=jdbc:postgresql://postgres:5432/finalcasedb?currentSchema=orders
PAYMENT_DB_URL=jdbc:postgresql://postgres:5432/finalcasedb?currentSchema=payment
SHIPMENT_DB_URL=jdbc:postgresql://postgres:5432/finalcasedb?currentSchema=shipment
CHECKOUT_DB_URL=jdbc:postgresql://postgres:5432/finalcasedb?currentSchema=checkout
NOTIFICATION_DB_URL=jdbc:postgresql://postgres:5432/finalcasedb?currentSchema=notification
REVIEW_DB_URL=jdbc:postgresql://postgres:5432/finalcasedb?currentSchema=review

# ------------------------------------------------------------
# RabbitMQ
# ------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=finalcase
RABBITMQ_PASSWORD=change-me

# ------------------------------------------------------------
# Eureka
# ------------------------------------------------------------
EUREKA_DEFAULT_ZONE=http://discovery-service:8761/eureka

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
JWT_SECRET=change-me-generate-a-strong-secret
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=14

# ------------------------------------------------------------
# Iyzico sandbox
# ------------------------------------------------------------
IYZICO_API_KEY=change-me
IYZICO_SECRET_KEY=change-me
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ------------------------------------------------------------
# Payment URLs
# ------------------------------------------------------------
PAYMENT_PUBLIC_BASE_URL=http://localhost:8080
PAYMENT_SUCCESS_REDIRECT_URL=http://localhost:5173/payment/success
PAYMENT_FAILURE_REDIRECT_URL=http://localhost:5173/payment/failure

# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Host ports for local tools
GATEWAY_PORT=8080
EUREKA_PORT=8761
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
